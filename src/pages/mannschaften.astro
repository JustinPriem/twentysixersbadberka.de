---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const teams = (await getCollection("mannschaften")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
const rendered = await Promise.all(teams.map((t) => render(t)));
---

<BaseLayout
  title="Mannschaften"
  description="Alle Mannschaften von twentysixersbadberka im Überblick – Liga, Trainingszeiten und Kapitän:innen."
>
  <section class="section page-hero">
    <div class="container reveal">
      <span class="eyebrow">Spielbetrieb</span>
      <h1>Unsere Mannschaften</h1>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      {teams.map((team, i) => {
        const { Content } = rendered[i];
        return (
          <div class="card reveal">
            <span class="eyebrow">{team.data.liga}</span>
            <h2>{team.data.name}</h2>
            <p>
              {team.data.kapitaen && <>Kapitän:in: {team.data.kapitaen}<br /></>}
              {team.data.trainingszeit && <>Training: {team.data.trainingszeit}</>}
            </p>
            <div class="team-body"><Content /></div>
          </div>
        );
      })}
      {teams.length === 0 && <p class="reveal">Noch keine Mannschaften eingetragen.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: var(--space-lg) var(--space-md); }
  .team-body { margin-top: var(--space-sm); }
  .team-body :global(p) { margin-bottom: 0.5rem; }
</style>
