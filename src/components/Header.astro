---
const nav = [
  { href: "/verein/", label: "Der Verein" },
  { href: "/mannschaften/", label: "Mannschaften" },
  { href: "/termine/", label: "Termine" },
  { href: "/ergebnisse/", label: "Ergebnisse" },
  { href: "/news/", label: "News" },
  { href: "/galerie/", label: "Galerie" },
  { href: "/mitglied-werden/", label: "Mitglied werden" },
  { href: "/kontakt/", label: "Kontakt" },
];
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="twentysixersbadberka – Startseite">
      <span class="brand__dart" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4"/>
          <circle cx="12" cy="12" r="5.5" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand__name">twentysixers<span class="brand__place">badberka</span></span>
    </a>

    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">Menü öffnen</span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" data-primary-nav aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(243, 236, 216, 0.08);
    transition: background 0.3s ease;
  }
  /* backdrop-filter absichtlich auf einem eigenen ::before statt direkt auf
     .site-header: filter/backdrop-filter auf einem Vorfahren erzeugt einen
     neuen Containing Block für position:fixed-Kinder (siehe .primary-nav
     unten) – dadurch würde das mobile Menü nicht mehr relativ zum
     Bildschirm, sondern relativ zur (kleinen) Header-Leiste positioniert.
     Bekannte CSS-Falle, hat auf echten Mobilgeräten das Menü kaputt gemacht. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(11, 11, 13, 0.75);
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    color: var(--color-cream);
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; color: var(--color-gold-bright); }
  .brand__dart { color: var(--color-gold); display: inline-flex; }
  .brand__place { color: var(--color-gold); font-weight: 500; }

  .primary-nav ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }
  .primary-nav a {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding-block: 0.25rem;
  }
  .primary-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--color-gold);
    transition: width 0.25s var(--ease-out);
  }
  .primary-nav a:hover {
    color: var(--color-cream);
    text-decoration: none;
  }
  .primary-nav a:hover::after { width: 100%; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    /* Muss über dem geöffneten .primary-nav-Panel liegen (position:fixed
       ohne z-index stapelt sich sonst standardmäßig über normalem,
       unpositioniertem Inhalt) – sonst lässt sich das Menü nicht mehr
       schließen, weil das Panel den Button überdeckt. */
    position: relative;
    z-index: 101;
  }
  .nav-toggle__bar {
    width: 22px;
    height: 2px;
    background: var(--color-cream);
    transition: transform 0.25s var(--ease-out), opacity 0.25s var(--ease-out);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 860px) {
    .nav-toggle { display: inline-flex; }
    .primary-nav {
      position: fixed;
      inset: 0 0 0 30%;
      z-index: 100;
      background: var(--color-board-raised);
      transform: translateX(100%);
      transition: transform 0.35s var(--ease-out);
      padding: 6rem 2rem 2rem;
      border-left: 1px solid rgba(243, 236, 216, 0.1);
    }
    .primary-nav[data-open="true"] { transform: translateX(0); }
    .primary-nav ul {
      flex-direction: column;
      gap: 1.5rem;
    }
    .primary-nav a { font-size: 1.1rem; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-primary-nav]");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.getAttribute("data-open") === "true";
    nav?.setAttribute("data-open", String(!isOpen));
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav.setAttribute("data-open", "false");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  document.addEventListener("scroll", () => {
    if (header) {
      header.style.boxShadow = window.scrollY > 10 ? "0 10px 30px -20px rgba(0,0,0,0.6)" : "none";
    }
  }, { passive: true });
</script>
