{/*
  Hero-Sektion: Ein Dartpfeil fliegt beim Scrollen in die Triple-20, danach
  löst sich die Dartscheibe auf und der Vereinsname erscheint.
  Läuft komplett clientseitig (Three.js + GSAP ScrollTrigger), siehe
  src/lib/dartHero.ts. Respektiert prefers-reduced-motion.
*/}
<section class="dart-hero" data-dart-hero aria-label="twentysixersbadberka – Startanimation">
  <div class="dart-hero__canvas-wrap" data-canvas-wrap aria-hidden="true"></div>
  <div class="dart-hero__flash" data-impact-flash aria-hidden="true"></div>
  <div class="dart-hero__vignette" aria-hidden="true"></div>

  <div class="dart-hero__overlay">
    <p class="dart-hero__cue" data-scroll-cue>Scrollen für den Wurf ↓</p>

    <div class="dart-hero__reveal" data-hero-reveal>
      <span class="eyebrow" data-hero-eyebrow>Dartverein · Bad Berka</span>
      <h1 class="dart-hero__title">
        <span class="dart-hero__title-line" data-split-line>twentysixers</span>
        <span class="dart-hero__title-line dart-hero__title-line--accent" data-split-line>badberka</span>
      </h1>
      <p class="dart-hero__tagline" data-hero-tagline>Wir treffen, was zählt.</p>
      <a href="#verein-intro" class="btn btn--primary" data-hero-cta>Verein entdecken</a>
    </div>
  </div>
</section>

<style>
  .dart-hero {
    position: relative;
    height: 100vh;
    /* 100svh = "small viewport height", passt IMMER in den sichtbaren Bereich
       (auch mit eingeblendeter mobiler Adressleiste). Verhindert, dass die
       Dartscheibe beim Scroll-Start durch eine zu groß gemessene 100vh-Höhe
       teilweise aus dem sichtbaren Bereich rutscht. Browser ohne svh-Support
       ignorieren die Zeile und bleiben bei 100vh. */
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, #17151a 0%, #0b0b0d 70%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dart-hero__canvas-wrap {
    position: absolute;
    inset: 0;
  }
  .dart-hero__canvas-wrap :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  .dart-hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, transparent 40%, rgba(11, 11, 13, 0.85) 100%);
  }

  .dart-hero__flash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at 62% 42%, rgba(232, 199, 102, 0.9), rgba(232, 199, 102, 0) 60%);
  }

  .dart-hero__overlay {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-inline: var(--space-md);
    pointer-events: none;
  }

  .dart-hero__cue {
    position: absolute;
    bottom: -40vh;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    animation: bob 2.4s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  .dart-hero__reveal {
    /* Kein statisches opacity:0 hier: die Kind-Elemente (Buchstaben, Eyebrow,
       Tagline, CTA) werden von GSAP einzeln versteckt/animiert. Fällt JS aus,
       bleibt der Text so von Anfang an lesbar statt dauerhaft unsichtbar. */
    pointer-events: auto;
  }

  .dart-hero__title {
    font-size: clamp(2.75rem, 8vw, 6rem);
    margin-bottom: var(--space-xs);
    perspective: 500px;
  }
  .dart-hero__title-line {
    display: block;
  }
  .dart-hero__title-line--accent {
    color: var(--color-gold);
    font-size: 0.55em;
    letter-spacing: 0.08em;
  }
  .dart-hero__title :global(.char) {
    display: inline-block;
  }

  .dart-hero__tagline {
    font-size: 1.1rem;
    margin-bottom: var(--space-md);
  }

  /* Fallback für prefers-reduced-motion: kein Pin, kein Canvas-Loop nötig,
     Inhalt ist von Anfang an sichtbar (siehe .dart-hero__reveal oben). */
  .dart-hero.is-static {
    height: auto;
    min-height: 70vh;
    padding-block: var(--space-xl);
  }

  @media (max-width: 640px) {
    .dart-hero__cue { display: none; }
  }
</style>

<script>
  import { initDartHero } from "../lib/dartHero";
  initDartHero();
</script>
